# Referencia para EasyPanel > Entorno. No guardar valores reales en Git.
# Activar Create .env file. No dejar ningún marcador REEMPLAZAR al desplegar.
COMPOSE_PROJECT_NAME=servicios_mailtiendaya
MAILCOW_HOSTNAME=notificaciones.ya.com.bo
MAILCOW_DATA_PATH=/opt/mailcow-easypanel-data
TZ=America/La_Paz
IPV4_NETWORK=172.30.50
ENABLE_IPV6=false
HTTP_REDIRECT=n
DBNAME=mailcow
DBUSER=mailcow
DBPASS=REEMPLAZAR_SECRETO_ALEATORIO
DBROOT=REEMPLAZAR_SECRETO_DIFERENTE
REDISPASS=REEMPLAZAR_SECRETO_DIFERENTE
SOGO_URL_ENCRYPTION_KEY=REEMPLAZAR_SECRETO_DIFERENTE
ACME_ACCOUNT_EMAIL=REEMPLAZAR_CORREO_DE_CONTACTO
VERCEL_TOKEN=REEMPLAZAR_TOKEN_VERCEL
# No activar COMPOSE_PROFILES; netfilter fue eliminado de easypanel-compose.yml.
