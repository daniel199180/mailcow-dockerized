# EJEMPLO, NO COLOCAR SECRETOS EN GIT. Copiar manualmente a EasyPanel > Entorno.
# Requiere inicializar los archivos del repositorio en el directorio persistente antes del deploy.
MAILCOW_HOSTNAME=notificaciones.ya.com.bo
TZ=America/La_Paz
IPV4_NETWORK=172.30.50
ENABLE_IPV6=false
HTTP_BIND=127.0.0.1
HTTP_PORT=8088
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443
HTTP_REDIRECT=n
DBNAME=mailcow
DBUSER=mailcow
DBPASS=REEMPLAZAR_SECRETO_ALEATORIO
DBROOT=REEMPLAZAR_SECRETO_DIFERENTE
REDISPASS=REEMPLAZAR_SECRETO_DIFERENTE
ADDITIONAL_SAN=
COMPOSE_PROJECT_NAME=mailtiendaya
SOGO_EXPIRE_SESSION=480
# No iniciar sin resolver certificados y acceso del proxy.
